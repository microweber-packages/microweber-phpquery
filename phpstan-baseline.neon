parameters:
	ignoreErrors:
		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackBody has an unused parameter \$code\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackBody.php

		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackBody has an unused parameter \$param1\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackBody.php

		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackBody has an unused parameter \$param2\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackBody.php

		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackBody has an unused parameter \$param3\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackBody.php

		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackBody has an unused parameter \$paramList\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackBody.php

		-
			message: '#^Constructor of class MicroweberPackages\\PhpQuery\\Callbacks\\CallbackReturnReference has an unused parameter \$name\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: src/Callbacks/CallbackReturnReference.php

		-
			message: '#^Call to method setCookieJar\(\) on an unknown class MicroweberPackages\\PhpQuery\\Zend_Http_Client\.$#'
			identifier: class.notFound
			count: 1
			path: src/PhpQuery.php

		-
			message: '#^Class MicroweberPackages\\PhpQuery\\PhpQuery referenced with incorrect case\: MicroweberPackages\\PhpQuery\\phpQuery\.$#'
			identifier: class.nameCase
			count: 2
			path: src/PhpQuery.php

		-
			message: '#^Instantiated class MicroweberPackages\\PhpQuery\\Zend_Http_Client not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/PhpQuery.php

		-
			message: '#^Path in require_once\(\) "Zend/Http/Client\.php" is not a file or it does not exist\.$#'
			identifier: requireOnce.fileNotFound
			count: 1
			path: src/PhpQuery.php

		-
			message: '#^Class MicroweberPackages\\PhpQuery\\PhpQueryObject constructor invoked with 2 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/PhpQueryObject.php

		-
			message: '#^Method MicroweberPackages\\PhpQuery\\PhpQueryObject\:\:attrPHP\(\) should return MicroweberPackages\\PhpQuery\\PhpQueryObject but returns array\.$#'
			identifier: return.type
			count: 1
			path: src/PhpQueryObject.php

		-
			message: '#^Method MicroweberPackages\\PhpQuery\\PhpQueryObject\:\:next\(\) should return MicroweberPackages\\PhpQuery\\PhpQueryObject but return statement is missing\.$#'
			identifier: return.missing
			count: 2
			path: src/PhpQueryObject.php

		-
			message: '#^Parameter &\$documentID by\-ref type of method MicroweberPackages\\PhpQuery\\PhpQueryObject\:\:getDocumentIDRef\(\) expects string\|null, MicroweberPackages\\PhpQuery\\PhpQueryObject given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/PhpQueryObject.php
